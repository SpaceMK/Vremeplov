rules_version = '2';

// Security rules for Tales Tensor player saves.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore Database > Rules)
//
// The model is deliberately narrow: a signed-in player can read and write exactly
// one document - their own - and nothing else in the database is reachable from a
// client at all. Firestore's default "test mode" rules let any signed-in user read
// every other player's save, so do not ship without replacing them with these.
service cloud.firestore {
  match /databases/{database}/documents {

    // Shape check for a save document. This is not anti-cheat - a determined player
    // can still write whatever level they like into their own save - it only stops
    // malformed or oversized documents from being stored.
    function isValidSave(data) {
      return data.keys().hasAll(['payload', 'schemaVersion', 'updatedUtcTicks'])
          && data.payload is string
          && data.payload.size() < 200000     // ~200KB ceiling; real saves are a few KB
          && data.schemaVersion is int
          && data.updatedUtcTicks is int;
    }

    match /users/{uid} {
      // Only the owner, and only while actually authenticated.
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isValidSave(request.resource.data);

      // No client-side deletes; clearing a device is a local operation.
      allow delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
